# ----------------------------------------------------------
# Groq LLM (Required)
# Get a free key at https://console.groq.com
# ----------------------------------------------------------
GROQ_API_KEY=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
GROQ_MODEL=llama-3.1-8b-instant

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Set DEBUG=false for demos and production
DEBUG=false
LOG_LEVEL=INFO
LLM_PROVIDER=groq
FLOW_TIMEOUT_HOURS=24

# ----------------------------------------------------------
# Admin token (used by _require_admin() in main.py)
# Change this to a strong random string before any demo.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ----------------------------------------------------------
ADMIN_TOKEN=Z1*pQ6!vB9&fX4@zL1$mK2tY

# ----------------------------------------------------------
# Admin user passwords (read by auth.py)
# Change both before any demo or deployment.
# ---------------------------------------------------------- 
ADMIN_PASSWORD_ADMIN=5uperm@n
ADMIN_PASSWORD_SUPERADMIN=B@tman'sTHEB0SS

# ----------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# ----------------------------------------------------------
# CORS — add your company website origin here
# Example: CORS_ORIGINS=https://www.waterutility.zm,http://localhost:5173
# ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ============================================================
# Water Utility Chatbot — Environment Variables Template
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked  <CHANGE THIS>
# 3. NEVER commit the real .env to version control
# ============================================================

# ----------------------------------------------------------
# Groq LLM  (Required)
# Free key at https://console.groq.com
# ----------------------------------------------------------
GROQ_API_KEY=<CHANGE THIS — your Groq API key>
GROQ_MODEL=llama-3.1-8b-instant

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Set DEBUG=false for demos and production
DEBUG=false
LOG_LEVEL=INFO
LLM_PROVIDER=groq
FLOW_TIMEOUT_HOURS=24

# ----------------------------------------------------------
# Admin bearer token  (used by all /admin/* endpoints)
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ----------------------------------------------------------
ADMIN_TOKEN=<CHANGE THIS — strong random string>

# ----------------------------------------------------------
# Admin user passwords  (read by backend/auth.py)
# ----------------------------------------------------------
ADMIN_PASSWORD_ADMIN=<CHANGE THIS>
ADMIN_PASSWORD_SUPERADMIN=<CHANGE THIS>

# ----------------------------------------------------------
# Rate limiting
# ----------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=60

# Chat and Admin Specific Rate Limits
RATE_LIMIT_CHAT_REQUESTS=60
RATE_LIMIT_CHAT_WINDOW=60
RATE_LIMIT_ADMIN_REQUESTS=10
RATE_LIMIT_ADMIN_WINDOW=60

# ----------------------------------------------------------
# CORS — add your company website origin here
# Example: CORS_ORIGINS=https://www.waterutility.zm,http://localhost:5173
# ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ----------------------------------------------------------
# WhatsApp (future integration — leave blank until ready)
# ----------------------------------------------------------
# WHATSAPP_VERIFY_TOKEN=<your webhook verify token>
# WHATSAPP_ACCESS_TOKEN=<your WhatsApp Business API token>
# WHATSAPP_PHONE_NUMBER_ID=<your phone number ID>
